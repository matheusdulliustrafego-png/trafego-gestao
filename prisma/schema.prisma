datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum StatusCliente {
  ATIVO
  PAUSADO
  ENCERRADO
}

enum StatusPagamento {
  PENDENTE
  PAGO
  ATRASADO
}

enum StatusLead {
  NOVO
  EM_CONVERSA
  PROPOSTA_ENVIADA
  FECHADO
  PERDIDO
}

model Cliente {
  id            String        @id @default(cuid())
  nome          String
  slug          String        @unique
  contato       String        @default("")
  valorMensal   Float         @default(0)
  diaVencimento Int?
  status        StatusCliente @default(ATIVO)
  createdAt     DateTime      @default(now())

  briefing   Briefing?
  pagamentos Pagamento[]
  reunioes   Reuniao[]
}

model Briefing {
  id              String   @id @default(cuid())
  clienteId       String   @unique
  cliente         Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nicho           String   @default("")
  publicoAlvo     String   @default("")
  oferta          String   @default("")
  orcamentoMensal Float    @default(0)
  observacoes     String   @default("")
  updatedAt       DateTime @updatedAt
}

model Pagamento {
  id             String          @id @default(cuid())
  clienteId      String
  cliente        Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  referencia     String
  valor          Float
  status         StatusPagamento @default(PENDENTE)
  dataVencimento DateTime?
  dataPagamento  DateTime?
  createdAt      DateTime        @default(now())
}

model Reuniao {
  id          String   @id @default(cuid())
  titulo      String
  data        DateTime
  clienteId   String?
  cliente     Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  observacoes String   @default("")
  createdAt   DateTime @default(now())
}

model Lead {
  id          String     @id @default(cuid())
  nome        String
  contato     String     @default("")
  origem      String     @default("")
  status      StatusLead @default(NOVO)
  observacoes String     @default("")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
