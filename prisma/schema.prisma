datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum StatusCliente {
  ATIVO
  PAUSADO
  ENCERRADO
}

enum StatusPagamento {
  PENDENTE
  PAGO
  ATRASADO
}

enum ResultadoCriativo {
  BOM
  NEUTRO
  RUIM
}

enum StatusLead {
  NOVO
  EM_CONVERSA
  PROPOSTA_ENVIADA
  FECHADO
  PERDIDO
}

model Cliente {
  id            String        @id @default(cuid())
  nome          String
  slug          String        @unique
  contato       String        @default("")
  valorMensal   Float         @default(0)
  diaVencimento Int?
  cplAlvo       Float?
  status        StatusCliente @default(ATIVO)
  createdAt     DateTime      @default(now())

  briefing   Briefing?
  pagamentos Pagamento[]
  criativos  Criativo[]
  checagens  Checagem[]
}

model Briefing {
  id              String   @id @default(cuid())
  clienteId       String   @unique
  cliente         Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nicho           String   @default("")
  publicoAlvo     String   @default("")
  oferta          String   @default("")
  orcamentoMensal Float    @default(0)
  observacoes     String   @default("")
  updatedAt       DateTime @updatedAt
}

model Pagamento {
  id            String          @id @default(cuid())
  clienteId     String
  cliente       Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  referencia    String
  valor         Float
  status        StatusPagamento @default(PENDENTE)
  dataPagamento DateTime?
  createdAt     DateTime        @default(now())
}

model Criativo {
  id          String            @id @default(cuid())
  clienteId   String
  cliente     Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nome        String
  resultado   ResultadoCriativo @default(NEUTRO)
  observacoes String            @default("")
  createdAt   DateTime          @default(now())
}

model Checagem {
  id           String   @id @default(cuid())
  clienteId    String
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  investimento Float
  leads        Int
  createdAt    DateTime @default(now())
}

model Lead {
  id          String     @id @default(cuid())
  nome        String
  contato     String     @default("")
  origem      String     @default("")
  status      StatusLead @default(NOVO)
  observacoes String     @default("")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
