datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum StatusCliente {
  ATIVO
  PAUSADO
  ENCERRADO
}

enum StatusPagamento {
  PENDENTE
  PAGO
  ATRASADO
}

enum StatusLead {
  NOVO
  EM_CONVERSA
  PROPOSTA_ENVIADA
  FECHADO
  PERDIDO
}

enum OrigemLead {
  INSTAGRAM
  WHATSAPP
  INDICACAO
  GOOGLE
  SITE
  ANUNCIO_PAGO
  OUTRO
}

model Cliente {
  id            String        @id @default(cuid())
  nome          String
  slug          String        @unique
  contato       String        @default("")
  email         String        @default("")
  valorMensal   Float         @default(0)
  diaVencimento Int?
  status        StatusCliente @default(ATIVO)
  createdAt     DateTime      @default(now())

  briefing   Briefing?
  pagamentos Pagamento[]
  reunioes   Reuniao[]
  acessos    Acesso[]
  tarefas    Tarefa[]
}

model Briefing {
  id                String   @id @default(cuid())
  clienteId         String   @unique
  cliente           Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nicho             String   @default("")
  publicoAlvo       String[] @default([])
  diferenciais      String[] @default([])
  oferta            String   @default("")
  concorrentes      String[] @default([])
  objecoes          String[] @default([])
  objetivoPrincipal String   @default("")
  ticketMedio       Float    @default(0)
  orcamentoMensal   Float    @default(0)
  redesSociais      String[] @default([])
  observacoes       String   @default("")
  updatedAt         DateTime @updatedAt
}

model Pagamento {
  id             String          @id @default(cuid())
  clienteId      String
  cliente        Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  referencia     String
  valor          Float
  status         StatusPagamento @default(PENDENTE)
  dataVencimento DateTime?
  dataPagamento  DateTime?
  createdAt      DateTime        @default(now())
}

model Reuniao {
  id              String   @id @default(cuid())
  titulo          String
  data            DateTime
  clienteId       String?
  cliente         Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  observacoes     String   @default("")
  lembreteEnviado Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model Acesso {
  id          String   @id @default(cuid())
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  plataforma  String
  login       String   @default("")
  senha       String   @default("")
  observacoes String   @default("")
  createdAt   DateTime @default(now())
}

model Meta {
  id        String   @id @default(cuid())
  valor     Float
  updatedAt DateTime @updatedAt
}

model Lead {
  id          String     @id @default(cuid())
  nome        String
  contato     String     @default("")
  origem      OrigemLead @default(OUTRO)
  status      StatusLead @default(NOVO)
  observacoes String     @default("")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Despesa {
  id        String   @id @default(cuid())
  descricao String
  categoria String   @default("")
  valor     Float
  data      DateTime
  createdAt DateTime @default(now())
}

model Tarefa {
  id         String    @id @default(cuid())
  titulo     String
  concluida  Boolean   @default(false)
  dataLimite DateTime?
  clienteId  String?
  cliente    Cliente?  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
}
